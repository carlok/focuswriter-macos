# What to build. A release normally changes only UPSTREAM_TAG.
UPSTREAM_REPO=https://github.com/gottcode/focuswriter.git
UPSTREAM_TAG=v1.9.1
# Official Qt from download.qt.io, installed with aqtinstall (universal x86_64+arm64).
QT_VERSION=6.12.0
QT_MODULES="qtmultimedia qtimageformats"
AQT_VERSION=3.3.0
# Shown in Finder's Get Info and in the DMG, so users can tell this build
# apart from an official one.
PACKAGER_URL=https://github.com/carlok/focuswriter-macos
